# Copy this file to .env and fill in real values. .env is git-ignored.
# See docs/DEPLOY.md for the full self-hosting walkthrough.

# --- Main app (read by ecosystem.config.cjs) ---
PORT=3006
HOST=127.0.0.1

# --- Auto-update webhook (scripts/deploy/webhook-server.js) ---
# Must match the "Secret" field on the GitHub webhook you configure.
# Generate one with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=change-me
WEBHOOK_PORT=9000
# Branch that triggers an auto-deploy on push.
DEPLOY_BRANCH=main

# --- Optional interpreters ---
# Only needed if you've installed jasmin.jar for the Jasmin (JVM assembly)
# language — see scripts/install-interpreters.sh.
# JASMIN_JAR=/opt/jasmin/jasmin.jar

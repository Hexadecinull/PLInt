# Auto-detect text files and normalize line endings to LF in the repo.
* text=auto eol=lf

# Explicit source types
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files, never diff, never modify line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary

# Let GitHub's linguist skip generated/vendored files in language stats and diffs
src/routeTree.gen.ts linguist-generated=true diff=false
package-lock.json linguist-generated=true
